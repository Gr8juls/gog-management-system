# ================================================
# GOG Management System - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git!
# ================================================

# --- Database ---

# Local Development with SQLite:
DATABASE_URL="file:./dev.db"

# Production with PostgreSQL (Docker / Supabase / Railway / etc.):
# DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# --- PostgreSQL (Docker) ---
POSTGRES_USER="gog_admin"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="gog_db"

# --- Auth ---
# Generate a secure random value, e.g.: openssl rand -hex 32
JWT_SECRET="replace-with-a-secure-random-32-character-secret"

# --- App ---
PORT=3000
NODE_ENV="development"
