# ================================================
# GOG Management System - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git!
# ================================================

# --- Database ---
# For Local MongoDB Replica Set (default for offline/local development):
DATABASE_URL="mongodb://127.0.0.1:27017/gog_management_system?replicaSet=rs0&directConnection=true"

# For MongoDB Atlas (cloud):
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.enkqgtm.mongodb.net/gog_management_system?retryWrites=true&w=majority&appName=Cluster0"

# (Alternative) For Production with PostgreSQL:
# DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# --- PostgreSQL (Docker - optional) ---
POSTGRES_USER="gog_admin"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="gog_db"

# --- Auth ---
# Generate a secure random value, e.g.: openssl rand -hex 32
JWT_SECRET="replace-with-a-secure-random-32-character-secret"

# --- App ---
PORT=3000
NODE_ENV="development"
